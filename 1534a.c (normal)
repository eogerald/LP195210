#include <stdio.h>

int main() {
    int N, i, j;

    while (scanf("%d", &N) != EOF) {
        for (i = 0; i < N; i++) {
            for (j = 0; j < N; j++) {
                if (i + j == N - 1)
                    printf("2");
                else if (i == j)
                    printf("1");
                else
                    printf("3");
            }
            printf("\n");
        }
        printf("\n");
    }

    return 0;
}
